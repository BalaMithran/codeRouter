# Secrets/env referenced by coderouter.yaml via ${VAR}. Everything else lives in the yaml.
CODEROUTER_OPENAI_KEY=sk-...

# Only read on bare-metal (docker-compose overrides this to the ollama service automatically).
CODEROUTER_OLLAMA_URL=http://localhost:11434/v1

# Optional
# PORT=8787
# CODEROUTER_CONFIG=coderouter.yaml
